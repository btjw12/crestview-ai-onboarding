# --- Required ---
# monday.com personal API token (Profile > Developers > My access tokens)
MONDAY_API_TOKEN=
# Anthropic (Claude) API key
ANTHROPIC_API_KEY=

# --- Optional ---
MONDAY_BOARD_ID=5032323173
# Pin a monday.com API version (e.g. 2025-04). Leave blank to use the account default.
MONDAY_API_VERSION=
ANTHROPIC_MODEL=claude-opus-5-5
LOG_LEVEL=INFO

GOOGLE_DRIVE_FOLDER_ID=YOUR_ACTUAL_FOLDER_ID